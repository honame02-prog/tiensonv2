 ],
 "texts": {
  "stele_a": {"prompt":"Đọc bia","lines":[{"who":"Bia đá cổ","text":"Chữ khắc đã mòn gần hết dưới lớp rêu. Chỉ còn đọc được mấy dòng: «Huyền Vân Quan, khai sơn năm thứ ba niên hiệu Thái Bình…»"},{"who":"Bia đá cổ","text":"«…tổ sư dẫn ba mươi sáu đệ tử lên núi, dựng điện thờ Tam Thanh giữa biển mây. Ngàn năm hương khói chưa từng tắt.»"}]},
  "stele_b": {"prompt":"Đọc bia","lines":[{"who":"Bia giới luật","text":"«Tĩnh tâm như nước, giữ đạo như núi. Vào sơn môn, chớ mang theo sân hận.»"},{"who":"Bia giới luật","text":"Bên dưới có ai khắc thêm một dòng nhỏ, nét còn mới: «Đi chậm thôi, rêu trơn lắm.»"}]},
  "burner": {"prompt":"Thắp hương","lines":[{"who":"Lư hương đồng","text":"Lư đồng đã xỉn màu rỉ xanh, tro hương phủ dày cả tấc."},{"who":"Đạo sĩ","text":"Thắp ba nén hương, kính Tam Thanh, kính tổ sư."}]},
  "burner_lit": {"prompt":"Thắp hương","lines":[{"who":"Lư hương đồng","text":"Khói hương lặng lẽ bay lên rồi tan vào sương núi."}]},
  "hall": {"prompt":"Xem cửa điện","lines":[{"who":"Chính điện","text":"Cánh cửa gỗ nặng khép hờ. Bên trong, tượng Tam Thanh mờ khuất sau làn khói trầm."},{"who":"Chính điện","text":"(Nội điện sẽ mở ở bản sau.)"}]},
  "gate": {"prompt":"Sơn môn","lines":[{"who":"Sơn môn","text":"Tấm biển gỗ trên cổng đã bạc màu, nét chữ vàng chỉ còn lờ mờ: «Huyền Vân Quan»."},{"who":"Sơn môn","text":"Bước qua cổng là bậc đá dài dẫn xuống núi."}]}
 },
